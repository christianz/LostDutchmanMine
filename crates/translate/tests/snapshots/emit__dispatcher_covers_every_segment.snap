// Generated by the translate crate from LDM.EXE (sample). Do not edit.
pub(crate) mod segment_0000 {
    use super::prelude::*;
    include!(concat!(env!("OUT_DIR"), "/segment_0000.rs"));
}
pub(crate) mod segment_0001 {
    use super::prelude::*;
    include!(concat!(env!("OUT_DIR"), "/segment_0001.rs"));
}

/// Runs translated code from CS:IP until it yields: one translated step.
pub(crate) fn step(m: &mut Machine, g: &mut Game) -> Result<(), Stop> {
    m.steps += 1;
    match m.regs.cs.wrapping_sub(LOAD_SEGMENT) {
        0x0000 => segment_0000::run(m, g),
        0x0001 => segment_0001::run(m, g),
        segment => Err(Stop::Unrecovered(Address::new(segment, m.regs.ip))),
    }
}

/// What callers of each readable routine observe, as `translate::liveness::Uses` bits.
pub(crate) const CONTRACTS: &[(Routine, u32)] = &[];
