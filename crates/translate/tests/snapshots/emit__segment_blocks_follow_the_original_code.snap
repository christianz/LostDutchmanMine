// Generated by the translate crate from LDM.EXE (sample). Do not edit.

/// Runs blocks of this segment until one yields.
pub(crate) fn run(m: &mut Machine, g: &mut Game) -> Result<(), Stop> {
    loop {
        let next = match m.regs.ip {
            0x0000 => b0000(m, g)?,
            0x000d => b000d(m, g)?,
            0x000e => b000e(m, g)?,
            0x0013 => b0013(m, g)?,
            0x0014 => b0014(m, g)?,
            0x001e => b001e(m, g)?,
            ip => return Err(Stop::Unrecovered(Address::new(0x0000, ip))),
        };
        match next {
            Next::Goto(ip) => m.regs.ip = ip,
            Next::Yield => return Ok(()),
        }
    }
}

/// 0000:0000
fn b0000(m: &mut Machine, g: &mut Game) -> Result<Next, Stop> {
    // 0000  mov ax, 0x1234
    m.regs.ax = 0x1234;
    // 0003  mov [bx], ax
    m.memory.write16(m.regs.ds, m.regs.bx, m.regs.ax);
    // 0005  add ax, 1
    m.regs.ax = m.alu(AluOp::Add, m.regs.ax, 0x0001, Width::Word);
    // 0008  jne 0x000e
    if m.condition(Cond::NotEqual) { return Ok(Next::Goto(0x000e)); }
    // 000a  call 0x0013
    return call(m, 0x0013, 0x000d);
}

/// 0000:000d
fn b000d(m: &mut Machine, g: &mut Game) -> Result<Next, Stop> {
    // 000d  nop
    Ok(Next::Goto(0x000e))
}

/// 0000:000e
fn b000e(m: &mut Machine, g: &mut Game) -> Result<Next, Stop> {
    // 000e  int 0x21
    m.regs.ip = 0x000e;
    if interrupt(m, g, 0x21)? { return Ok(Next::Yield); }
    // 0010  jmp 0
    return yield_at(m, 0x0000);
}

/// 0000:0013
fn b0013(m: &mut Machine, g: &mut Game) -> Result<Next, Stop> {
    // 0013  push bp
    m.regs.ip = 0x0013;
    if let Some(next) = before(m, g, Hook::MousePoll, 0x0014)? { return Ok(next); }
    m.push(m.regs.bp);
    Ok(Next::Goto(0x0014))
}

/// 0000:0014
fn b0014(m: &mut Machine, g: &mut Game) -> Result<Next, Stop> {
    // 0014  cmp word ptr [0x53dc], 0
    m.regs.ip = 0x0014;
    match replace(m, g, Hook::PanOwnership, 0x0019)? {
        Replaced::Original => {
            m.alu(AluOp::Sub, m.memory.read16(m.regs.ds, 0x53dc), 0x0000, Width::Word);
        }
        Replaced::Done => {}
        Replaced::Transfer(next) => return Ok(next),
    }
    // 0019  call far 0001:0000
    return far_call(m, Address::new(0x0001, 0x0000), 0x001e);
}

/// 0000:001e
fn b001e(m: &mut Machine, g: &mut Game) -> Result<Next, Stop> {
    // 001e  ret
    return ret(m, 0);
}
